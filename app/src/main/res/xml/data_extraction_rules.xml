<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for Android 12+. Same policy as
    backup_rules.xml: API keys and unfinished background replies stay on this
    device; chats, favourites and settings move with the user.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="xraiassistant_secure.xml" />
        <exclude domain="sharedpref" path="background_replies.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="xraiassistant_secure.xml" />
        <exclude domain="sharedpref" path="background_replies.xml" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        HTTPS only, validated against the system certificate authorities.

        User-installed certificates are trusted in debug builds only (debug-overrides),
        so a proxy can inspect traffic during development. Release builds ignore them:
        trusting user CAs in release lets anyone who can install a certificate on the
        device read API keys and prompts.
    -->
    <!--
        Cleartext is permitted here only because Android cannot limit it to local
        address ranges, and the optional Local model server (Settings) is usually
        plain HTTP on the user's network, e.g. Ollama at http://192.168.1.20:11434.
        The app's HTTP client refuses plain HTTP to any host that is not local or
        private (LocalServerConfig.isLocalHost), so every API call stays on HTTPS.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>

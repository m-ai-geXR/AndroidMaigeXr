<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        HTTPS only, validated against the system certificate authorities.

        User-installed certificates are trusted in debug builds only (debug-overrides),
        so a proxy can inspect traffic during development. Release builds ignore them:
        trusting user CAs in release lets anyone who can install a certificate on the
        device read API keys and prompts.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
